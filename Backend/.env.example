# =====================================================
# Database
# =====================================================

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nagrik_ai

SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nagrik_ai

# =====================================================
# JWT
# =====================================================

SECRET_KEY=change-me-to-a-long-random-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================================================
# Email (SMTP)
# =====================================================

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com

SMTP_PASSWORD=your-app-password

SMTP_FROM_EMAIL=your-email@gmail.com

SMTP_FROM_NAME=NAGRIK AI

# =====================================================
# Redis
# =====================================================

REDIS_URL=redis://localhost:6379/0

# =====================================================
# Celery
# =====================================================

CELERY_BROKER_URL=redis://localhost:6379/0

CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =====================================================
# AI
# =====================================================

GROQ_API_KEY=your-groq-api-key

# =====================================================
# Application
# =====================================================

ENVIRONMENT=development

DEBUG=True