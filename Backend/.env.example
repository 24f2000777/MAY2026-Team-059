# =====================================================
# Database (Supabase Postgres)
# =====================================================

# Transaction pooler (port 6543) — used by the async app connection.
# Get this from Supabase dashboard: Connect > Direct connection > Transaction pooler.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used only by scripts that run DDL (e.g. test_db.py).
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# =====================================================
# JWT
# =====================================================

SECRET_KEY=change-me-to-a-long-random-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================================================
# Email (SMTP)
# =====================================================
#
# These are a REAL, shared Ethereal sandbox account (ethereal.email),
# not a placeholder to replace with your own Gmail. Ethereal is a fake
# SMTP relay meant exactly for this: it accepts and "sends" mail to any
# address, real or made up, without ever actually delivering it
# anywhere. Register locally with any fake email you like, then log
# into ethereal.email with the same username/password below to read
# the OTP it "sent". Safe to keep shared/committed since nothing here
# protects anything real, if it ever needs rotating, generate a new
# one at ethereal.email/create and update this file.

SMTP_HOST=smtp.ethereal.email

SMTP_PORT=587

SMTP_USERNAME=jarred.morissette56@ethereal.email

SMTP_PASSWORD=n1PMcC1TBq1FUTEZ9y

SMTP_FROM_EMAIL=jarred.morissette56@ethereal.email

SMTP_FROM_NAME=NAGRIK AI

# =====================================================
# Redis
# =====================================================

REDIS_URL=redis://localhost:6379/0
OTP_SECRET_KEY=some_long_random_string_at_least_32_characters_long

# =====================================================
# Celery
# =====================================================

CELERY_BROKER_URL=redis://localhost:6379/0

CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =====================================================
# AI
# =====================================================

GROQ_API_KEY=your-groq-api-key

# Optional fallback providers for severity extraction, only used if Groq fails
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# =====================================================
# Complaint Attachments
# =====================================================
#
# All three have sane defaults (see app/core/config.py), only set
# these if you want to override them.

# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_BYTES=5242880
# MAX_ATTACHMENTS_PER_COMPLAINT=5

# =====================================================
# Application
# =====================================================

ENVIRONMENT=development

DEBUG=True