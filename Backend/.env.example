# =====================================================
# Database (Supabase Postgres)
# =====================================================

# Transaction pooler (port 6543) — used by the async app connection.
# Get this from Supabase dashboard: Connect > Direct connection > Transaction pooler.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used only by scripts that run DDL (e.g. test_db.py).
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# =====================================================
# JWT
# =====================================================

SECRET_KEY=change-me-to-a-long-random-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

# =====================================================
# Email (SMTP)
# =====================================================

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com

SMTP_PASSWORD=your-app-password

SMTP_FROM_EMAIL=your-email@gmail.com

SMTP_FROM_NAME=NAGRIK AI

# =====================================================
# Redis
# =====================================================

REDIS_URL=redis://localhost:6379/0
OTP_SECRET_KEY=some_long_random_string

# =====================================================
# Celery
# =====================================================

CELERY_BROKER_URL=redis://localhost:6379/0

CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =====================================================
# AI
# =====================================================

GROQ_API_KEY=your-groq-api-key

# =====================================================
# Application
# =====================================================

ENVIRONMENT=development

DEBUG=True